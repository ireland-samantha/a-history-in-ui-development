{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WireframeSeedDatasetSchema",
  "description": "JSON Schema for A History in UI Development (1966-2026) ~1,000+ Unique Wireframes Corpus",
  "type": "object",
  "required": [
    "datasetName",
    "version",
    "yearRange",
    "totalWireframes",
    "wireframes"
  ],
  "properties": {
    "Wireframe": {
      "type": "object",
      "required": [
        "id",
        "title",
        "year",
        "decade",
        "era",
        "platform",
        "domain",
        "webLayoutEngine",
        "layoutSpec",
        "uxMetrics",
        "uxResearchNotes",
        "predecessorIds",
        "successorIds",
        "structuralHash"
      ]
    }
  }
}